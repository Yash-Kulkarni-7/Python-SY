import re

text = "Hello My Name Is Yash. I have 20 apples and 10 oranges. Contact me at 9309993698."

# Get numbers
numbers = re.findall(r'\d+', text)

# Find mobile number
mobile = re.findall(r'\d{10}', text)

# Check capital alphabets
capital = re.findall(r'[A-Z]', text)

print("Numbers:", numbers)
print("Mobile Numbers:", mobile)
print("Capital Alphabets:", capital)
